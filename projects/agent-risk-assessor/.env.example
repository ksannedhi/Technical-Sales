# Anthropic API key — used only for the risk-committee brief.
# Without it, the assessment, path to Go, register, and PDF all still work; the brief is omitted.
ANTHROPIC_API_KEY=your_key_here

# Model for the brief. Defaults to claude-opus-5-5.
# CLAUDE_MODEL=claude-opus-5-5

# Optional: Chrome path for PDF export if Puppeteer can't find installed Chrome
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Backend port (default 3006)
PORT=3006

# Frontend origin for CORS (local dev)
CORS_ORIGIN=http://localhost:5181
